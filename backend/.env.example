# ==============================================================================
# INEL IHLR (In-House Line Return) Quality Portal - Environment Configuration
# Copy this file to .env in the backend root directory (backend/.env)
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_qtrack

# JWT Authentication
JWT_SECRET=inel_qtrack_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
RESPONSE_ENCRYPTION_KEY=inel_qtrack_aes_response_secret_key_2026
# ENCRYPT_RESPONSE=true

# CORS Origin & Frontend URL (Use machine IP so mail links work across LAN/devices)
CORS_ORIGIN=*
HOST_IP=192.168.0.168
FRONTEND_PORT=5173
FRONTEND_URL=http://192.168.0.168:5173
FRONTEND_NETWORK_URL=http://192.168.0.168:5173

# Notification Focus (ALL or comma-separated: IHLR,PROCESS_AUDIT)
EMAIL_FOCUS_MODULE=ALL


# Microsoft Office 365 / Outlook SMTP (Standard for @inel.co.in):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quality.pondy@inel.co.in
SMTP_PASS=your_email_password
SMTP_FROM="Q TRACK" <quality.pondy@inel.co.in>
