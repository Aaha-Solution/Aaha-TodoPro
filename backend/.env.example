# ==============================================================================
# INEL IHLR (In-House Line Return) Quality Portal - Environment Configuration
# Copy this file to .env in the backend root directory (backend/.env)
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# JWT Authentication
JWT_SECRET=inel_todo_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS Origin & Frontend URL
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173

# Notification Focus (ALL or comma-separated: IHLR,PROCESS_AUDIT)
EMAIL_FOCUS_MODULE=ALL

# ==============================================================================
# Outbound SMTP Email Configuration (Strictly fetched from .env)
# Outbound email notifications for IHLR defect reporting, reassignment,
# and 5-Why root cause & closer actions fetch strictly from these env vars:
# ==============================================================================

# Microsoft Office 365 / Outlook SMTP (Standard for @inel.co.in):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quality.pondy@inel.co.in
SMTP_PASS=your_email_password
SMTP_FROM="INEL IHLR Portal" <quality.pondy@inel.co.in>
