# ==============================================================================
# INEL Quality Management Portal - Backend Global Environment Configuration
# Copy this file to .env in the backend root directory
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Frontend URL (Used in notification email action links)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (For live escalation, approval & assignment notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_company_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="INEL Quality Portal" <your_company_email@gmail.com>
