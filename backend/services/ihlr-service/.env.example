# ==============================================================================
# INEL IHLR Service (:5003) Environment Configuration
# Copy this file to .env in backend/services/ihlr-service/
# ==============================================================================

PORT=5003
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_qtrack

# JWT Authentication
JWT_SECRET=inel_qtrack_super_secret_jwt_key_2026

# CORS & Frontend URL (Use machine IP so mail links work across LAN/devices)
CORS_ORIGIN=*
HOST_IP=192.168.0.168
FRONTEND_PORT=5173
FRONTEND_URL=http://192.168.0.168:5173
FRONTEND_NETWORK_URL=http://192.168.0.168:5173

# Notification Focus (Strictly focused on IHLR)
EMAIL_FOCUS_MODULE=IHLR

# NOTE: SMTP & Email credentials are configured centrally in root backend/.env
