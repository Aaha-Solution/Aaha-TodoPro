# ==============================================================================
# INEL IHLR Service (:5003) Environment Configuration
# Copy this file to .env in backend/services/ihlr-service/
# ==============================================================================

PORT=5003
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# CORS
CORS_ORIGIN=*

# SMTP Notification Settings (Shared Mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_company_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="INEL Quality Portal" <your_company_email@gmail.com>
FRONTEND_URL=http://localhost:5173
