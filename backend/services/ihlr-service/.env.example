# ==============================================================================
# INEL IHLR Service (:5003) Environment Configuration
# Copy this file to .env in backend/services/ihlr-service/
# ==============================================================================

PORT=5003
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# JWT Authentication
JWT_SECRET=inel_todo_super_secret_jwt_key_2026

# CORS
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173

# Outbound SMTP Notification Settings (Shared Mailer)
# All email triggers fetch directly from these environment variables:
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="INEL Quality Portal" <your_email@example.com>
