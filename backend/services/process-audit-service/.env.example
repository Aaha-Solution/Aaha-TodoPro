# ==============================================================================
# INEL Process Audit Service (:5002) Environment Configuration
# Copy this file to .env in backend/services/process-audit-service/
# ==============================================================================

PORT=5002
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_qtrack

# CORS
CORS_ORIGIN=*

# NOTE: SMTP & Email credentials are configured centrally in root backend/.env

HOST_IP=192.168.0.168
FRONTEND_PORT=5173
FRONTEND_URL=http://192.168.0.168:5173
FRONTEND_NETWORK_URL=http://192.168.0.168:5173
