# ==============================================================================
# INEL Process Audit Service (:5002) Environment Configuration
# Copy this file to .env in backend/services/process-audit-service/
# ==============================================================================

PORT=5002
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# CORS
CORS_ORIGIN=*

# Live SMTP Email Settings (INEL Office 365)
EMAIL_FOCUS_MODULE=ALL
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quality.pondy@inel.co.in
SMTP_PASS=your_email_password
SMTP_FROM="INEL Process Audit Portal" <quality.pondy@inel.co.in>
FRONTEND_URL=http://localhost:5173
