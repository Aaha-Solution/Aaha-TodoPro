# ==============================================================================
# INEL Process Audit Service (:4002) Environment Configuration
# Copy this file to .env in backend/services/process-audit-service/
# ==============================================================================

PORT=4002
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_qtrack

# CORS
CORS_ORIGIN=*

# NOTE: SMTP & Email credentials are configured centrally in root backend/.env

HOST_IP=192.168.0.168
FRONTEND_PORT=3000
FRONTEND_URL=http://192.168.0.168:3000
FRONTEND_NETWORK_URL=http://192.168.0.168:3000
