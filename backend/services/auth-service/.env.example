# ==============================================================================
# INEL Auth Service (:5001) Environment Configuration
# Copy this file to .env in backend/services/auth-service/
# ==============================================================================

PORT=5001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# JWT Token Settings
JWT_SECRET=inel_todo_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Outbound SMTP Notification Settings
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="INEL Quality Portal" <your_email@example.com>
