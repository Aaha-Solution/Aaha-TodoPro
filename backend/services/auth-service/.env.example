# ==============================================================================
# INEL Auth Service (:5001) Environment Configuration
# Copy this file to .env in backend/services/auth-service/
# ==============================================================================

PORT=5001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_qtrack

# JWT Token Settings
JWT_SECRET=inel_qtrack_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# NOTE: SMTP & Email credentials are configured centrally in root backend/.env
