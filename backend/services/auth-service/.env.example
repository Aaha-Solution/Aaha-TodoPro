# ==============================================================================
# INEL Auth Service (:5001) Environment Configuration
# Copy this file to .env in backend/services/auth-service/
# ==============================================================================

PORT=5001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inel_todo

# JWT Token Settings
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
