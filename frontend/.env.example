# ==============================================================================
# INEL Quality Management Portal - Frontend Environment Configuration
# Copy this file to .env in the frontend/ root directory
# ==============================================================================

# API Gateway Endpoint (Local / LAN Network IP)
VITE_API_BASE_URL=http://192.168.0.168:5000/api
VITE_GATEWAY_URL=http://192.168.0.168:5000

# Application Branding
VITE_APP_NAME="Q TRACK"

# AES Response Encryption Settings
VITE_RESPONSE_ENCRYPTION_KEY=inel_qtrack_aes_response_secret_key_2026
# Set to true to test encryption in dev mode (automatically active in production/dist build)
# VITE_ENCRYPT_RESPONSE=true

# VITE_API_BASE_URL=https://api.sadhish.info/api
# VITE_GATEWAY_URL=https://api.sadhish.info
